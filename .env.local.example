# .env.local.example

# Firebase Configuration
# Get these values from your Firebase Console:
# 1. Go to Project Settings > General
# 2. Copy the firebaseConfig object
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Google Gemini AI API
# Get your API key from: https://ai.google.dev/
# Enable the Generative Language API in Google Cloud Console
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Application URL (for metadata and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel KV (optional - for production rate limiting)
# If not set, uses in-memory rate limiter (suitable for development)
# Get credentials from: https://vercel.com/docs/storage/vercel-kv/quickstart
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Environment
NODE_ENV=development
